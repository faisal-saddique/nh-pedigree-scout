# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Example (local):   postgresql://postgres:password@localhost:5432/nh_pedigree
# Example (Neon):    postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/nh_pedigree

# Groq API key — free, no credit card. Get at https://console.groq.com → API Keys
GROQ_API_KEY=your-groq-api-key-here

# Scraper backend for Goffs (Cloudflare bypass)
# scrapedo — headless, requires SCRAPEDO_TOKEN below (free tier = 1,000 credits/month)
# nodriver  — opens real Chrome briefly, no token or account needed
SCRAPER_BACKEND=scrapedo

# Scrape.do token — only needed if SCRAPER_BACKEND=scrapedo
# Free tier: https://scrape.do  (no credit card required)
# SCRAPEDO_TOKEN=your-scrapedo-token
